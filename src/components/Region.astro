---
import { BLOCKS, type BlockName } from "../blocks/registry";
import { siteLayout } from "../site.config";
import type { BlockPlacement, RegionName } from "../types/layout";

export interface Props {
  /** Which region of site.config.ts to render. */
  name: RegionName;
  /**
   * Page-level data handed to every block in the region (headings, post, ...).
   * Blocks read what they need and ignore the rest; config props win on a
   * name clash so a placement can always override the page.
   */
  context?: Record<string, unknown>;
  /** Replaces the configured list for this page. Pass [] to render nothing. */
  override?: BlockPlacement[];
}

const { name, context = {}, override } = Astro.props;

const placements: BlockPlacement[] = override ?? siteLayout.regions[name] ?? [];
const entries = placements.map((placement) =>
  typeof placement === "string"
    ? { use: placement, props: {} as Record<string, unknown> }
    : { props: {} as Record<string, unknown>, ...placement },
);
---

{
  entries.map(({ use, props }) => {
    const Block = BLOCKS[use as BlockName];
    return Block ? <Block {...context} {...props} /> : null;
  })
}

---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../skins/minimal/tokens.css";
import "../skins/anime/tokens.css";
import "../styles/global.css";
import { SKINS, SKIN_THEME_COLORS } from "../skins";
import { siteLayout } from "../site.config";
import type { ImageMetadata } from "astro";
// og/twitter 分享图必须是位图：X/Facebook/Telegram 的抓取器不渲染 SVG。
// cover-og.png 由 cover.svg 渲染裁剪而来（1200x630 标准卡片尺寸）。
import FallbackImage from "../assets/cover-og.png";
import { SITE_ORIGIN, SITE_TITLE } from "../consts";
import { normalizePathname } from "../utils/canonical";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = FallbackImage,
  canonicalPath,
  noindex = false,
} = Astro.props;
const pathname = normalizePathname(Astro.url.pathname);
const basePathname = normalizePathname(import.meta.env.BASE_URL);
const stripBasePrefix = (value: string): string => {
  if (basePathname === "/") return value;
  if (value === basePathname) return "/";
  if (value.startsWith(`${basePathname}/`)) {
    return value.slice(basePathname.length) || "/";
  }

  const baseWithoutLeadingSlash = basePathname.startsWith("/")
    ? basePathname.slice(1)
    : basePathname;
  if (value.startsWith(`${baseWithoutLeadingSlash}/`)) {
    return `/${value.slice(baseWithoutLeadingSlash.length)}`;
  }

  return value;
};
const canonicalSourcePath = normalizePathname(stripBasePrefix(pathname));
const resolvedCanonicalPath = canonicalPath
  ? normalizePathname(canonicalPath)
  : canonicalSourcePath;
const siteOrigin = new URL(SITE_ORIGIN);
const resolvedImagePath = stripBasePrefix(image.src);
const canonicalURL = new URL(resolvedCanonicalPath, siteOrigin);
const rssURL = new URL("rss.xml", siteOrigin);
const metaImageURL = new URL(resolvedImagePath, siteOrigin);
const isFallbackDeployment =
  import.meta.env.PUBLIC_IS_FALLBACK_DEPLOYMENT === "true";
const shouldNoindex = noindex || isFallbackDeployment;
const primaryHostname = canonicalURL.hostname;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/jpeg" href={withBase("/head.jpg")} />

<!-- Fonts: preconnect + async (non-render-blocking) load of LXGW WenKai.
     Until it arrives, the CSS font stack falls back to system fonts so the
     page paints immediately, then swaps in the web font. -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
  />
</noscript>
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={rssURL}
/>
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />

<!-- 主题初始化脚本 -->
<script
  is:inline
  define:vars={{ defaultSkin: siteLayout.skin, skinThemeColors: SKIN_THEME_COLORS, skinNames: SKINS }}
>
  (() => {
    const MODE_KEY = "theme";
    const SKIN_KEY = "skin";
    const DEFAULT_MODE = "dark";

    const readStored = (key, allowed) => {
      try {
        const value = localStorage.getItem(key);
        return allowed.includes(value) ? value : null;
      } catch {
        return null;
      }
    };

    const writeStored = (key, value) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        // Ignore storage errors and keep the choice in memory/DOM only.
      }
    };

    const syncThemeColor = (skin, mode) => {
      let meta = document.head.querySelector('meta[name="theme-color"]');
      if (!meta) {
        meta = document.createElement("meta");
        meta.setAttribute("name", "theme-color");
        document.head.appendChild(meta);
      }
      const palette = skinThemeColors[skin] || skinThemeColors[defaultSkin];
      meta.setAttribute("content", palette[mode]);
    };

    const getAppliedMode = () => {
      const current = document.documentElement.dataset.theme;
      if (current === "dark" || current === "light") return current;
      return document.documentElement.classList.contains("dark") ? "dark" : null;
    };

    const getMode = () =>
      readStored(MODE_KEY, ["dark", "light"]) ?? getAppliedMode() ?? DEFAULT_MODE;

    // The server already stamps data-skin on <html>, so this only ever
    // narrows to a visitor's stored choice - there is no unskinned frame.
    const getSkin = () =>
      readStored(SKIN_KEY, skinNames) ??
      (skinNames.includes(document.documentElement.dataset.skin)
        ? document.documentElement.dataset.skin
        : defaultSkin);

    const apply = (skin, mode, { persist = true } = {}) => {
      const nextMode = mode === "light" ? "light" : "dark";
      const nextSkin = skinNames.includes(skin) ? skin : defaultSkin;
      const root = document.documentElement;

      // .dark is kept alongside data-mode: global.css and two blocks still
      // select on it, and tailwind.config.js is darkMode: "class".
      root.classList.toggle("dark", nextMode === "dark");
      root.dataset.theme = nextMode;
      root.dataset.mode = nextMode;
      root.dataset.skin = nextSkin;
      root.style.colorScheme = nextMode;
      syncThemeColor(nextSkin, nextMode);

      if (persist) {
        writeStored(MODE_KEY, nextMode);
        writeStored(SKIN_KEY, nextSkin);
      }
      document.dispatchEvent(
        new CustomEvent("site:skin-change", {
          detail: { skin: nextSkin, mode: nextMode },
        }),
      );
      return nextMode;
    };

    window.__siteTheme = {
      storageKey: MODE_KEY,
      skinStorageKey: SKIN_KEY,
      defaultTheme: DEFAULT_MODE,
      defaultSkin,
      skins: skinNames,
      getTheme: getMode,
      getSkin,
      applyTheme: (mode, options) => apply(getSkin(), mode, options),
      toggleTheme: () =>
        apply(getSkin(), getMode() === "dark" ? "light" : "dark"),
      setSkin: (skin) => {
        apply(skin, getMode());
        return skin;
      },
      cycleSkin: () => {
        const next =
          skinNames[(skinNames.indexOf(getSkin()) + 1) % skinNames.length];
        apply(next, getMode());
        return next;
      },
    };

    // Resolve both axes before first paint.
    apply(getSkin(), getMode(), { persist: false });
  })();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<script is:inline define:vars={{ primaryHostname, shouldNoindex }}>
  if (!shouldNoindex && window.location.hostname !== primaryHostname) {
    const existingRobots = document.head.querySelector('meta[name="robots"]');
    if (existingRobots) {
      existingRobots.setAttribute("content", "noindex,follow");
    } else {
      const robots = document.createElement("meta");
      robots.name = "robots";
      robots.content = "noindex,follow";
      document.head.appendChild(robots);
    }
  }
</script>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{shouldNoindex && <meta name="robots" content="noindex,follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={metaImageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={metaImageURL} />

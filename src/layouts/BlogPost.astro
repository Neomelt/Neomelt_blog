---
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Comments from "../blocks/view/Comments.astro";
import TableOfContents from "../blocks/widget/TableOfContents.astro";
import GlassPanel from "../blocks/surface/GlassPanel.astro";
import PostNavigation from "../blocks/view/PostNavigation.astro";
import SeriesNav from "../blocks/view/SeriesNav.astro";
import BaseLayout from "./BaseLayout.astro";
import Region from "../components/Region.astro";
import { siteLayout } from "../site.config";
import { getWalinePathForPost } from "../utils/waline";
import { getDefaultUiText } from "../i18n/ui";
import { resolvePostDates } from "../utils/post-dates";
import { estimateReadingTime } from "../utils/reading-time";
import { postTitleTransition } from "../utils/transition";
import { withBase } from "../utils/url";
import "../styles/md-components.css";

export interface Props {
  post: CollectionEntry<"blog">;
  headings: { depth: number; slug: string; text: string }[];
  /** Load the KaTeX stylesheet; set by utils/remark-math-flag. */
  hasMath?: boolean;
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const { post, headings, hasMath = false, prevPost, nextPost } = Astro.props;
const { title, description, tags } = post.data;
const { pubDate: resolvedPubDate, updatedDate: resolvedUpdatedDate } =
  await resolvePostDates(post);
const walinePath = getWalinePathForPost(post.id);
const shouldShowUpdated =
  resolvedUpdatedDate.valueOf() > resolvedPubDate.valueOf();

const wordCount = (post.body || "").length;
const readingTime = estimateReadingTime(post.body || "");

// Every post pins its own cover, so shares carry that rather than one shared
// card for the whole site.
const shareImage =
  typeof post.data.heroImage === "object" && post.data.heroImage
    ? (post.data.heroImage as ImageMetadata)
    : undefined;
// The left sidebar is independent of the table of contents: personal widgets
// stay on the left and headings get their own right rail on wide screens.
const hasSidebar = siteLayout.regions.asideStart.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  katex={hasMath}
  image={shareImage}
  sidebar={false}
>
  <div class="post-page">
    {
      hasSidebar && (
        <aside class="post-sidebar">
          <Region name="asideStart" context={{ headings, post }} />
        </aside>
      )
    }

    <main class="container">
      <!-- Breadcrumb -->
      <nav
        class="breadcrumb"
        data-i18n-aria-label="post.breadcrumbAria"
        aria-label={getDefaultUiText("post.breadcrumbAria")}
      >
        <a href={withBase("/")} data-i18n="common.home"
          >{getDefaultUiText("common.home")}</a
        >
        <span class="breadcrumb-sep">/</span>
        <a href={withBase("/posts")} data-i18n="common.posts"
          >{getDefaultUiText("common.posts")}</a
        >
        <span class="breadcrumb-sep">/</span>
        <span>{title}</span>
      </nav>

      <article class:list={{ "post-story": post.data.type === "story" }}>
        <!-- Post header -->
        <header class="post-header">
          <h1 class="post-title" style={postTitleTransition(post.id)}>
            {title}
          </h1>
          <div class="post-meta-row">
            <FormattedDate date={resolvedPubDate} showTime={true} />
            <span class="text-muted">·</span>
            <span class="text-muted text-sm">
              {wordCount}
              <span data-i18n="common.words"
                >{getDefaultUiText("common.words")}</span
              > · {readingTime}
              <span data-i18n="common.minutes"
                >{getDefaultUiText("common.minutes")}</span
              >
            </span>
            {
              shouldShowUpdated && (
                <span class="text-muted text-sm">
                  · （
                  <span data-i18n="common.updatedAt">
                    {getDefaultUiText("common.updatedAt")}
                  </span>{" "}
                  <FormattedDate date={resolvedUpdatedDate} showTime={true} />）
                </span>
              )
            }
          </div>
          <div
            class="post-stats"
            data-i18n-aria-label="post.statsAria"
            aria-label={getDefaultUiText("post.statsAria")}
          >
            <p class="post-stats-line">
              <span class="waline-pageview-count" data-path={walinePath}>0</span
              >
              <span data-i18n="common.views"
                >{getDefaultUiText("common.views")}</span
              > /
              <span class="waline-comment-count" data-path={walinePath}>0</span>
              <span data-i18n="common.comments"
                >{getDefaultUiText("common.comments")}</span
              >
            </p>
          </div>
          {
            tags && tags.length > 0 && (
              <div class="post-tags-row">
                {tags.map((tag: string) => (
                  <a href={withBase(`/tags#${tag}`)} class="tag">
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        <!-- Mobile TOC (collapsible) -->
        <details class="mobile-toc">
          <summary data-i18n="common.toc">
            {getDefaultUiText("common.toc")}
          </summary>
          <TableOfContents headings={headings} />
        </details>

        <!-- Post content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Post navigation -->
        <!-- Renders nothing unless the post declares a series. -->
        <SeriesNav post={post} />

        <PostNavigation prevPost={prevPost} nextPost={nextPost} />

        <!-- Comments -->
        <Comments path={walinePath} />
      </article>
    </main>

    <aside class="toc-sidebar">
      <!-- Same surface as the widgets in the left rail, so both rails match. -->
      <GlassPanel>
        <TableOfContents headings={headings} />
      </GlassPanel>
    </aside>
  </div>
</BaseLayout>

<script>
  import "../scripts/md-components";
</script>

<style>
  .post-page {
    --post-layout-width: var(--article-shell-width);
    display: grid;
    grid-template-columns: clamp(200px, 16vw, var(--aside-width)) minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    width: min(calc(100% - 2.5rem), var(--post-layout-width));
    margin-inline: auto;
    padding-top: 0;
  }

  .post-sidebar {
    /* Same widget text scale as the home rails. */
    --widget-scale: var(--rail-text-scale);
    font-size: calc(1em * var(--widget-scale));
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    max-height: calc(100vh - var(--header-height) - 3rem);
    overflow-y: auto;
    align-self: start;
  }

  main.container {
    grid-column: 2;
    width: 100%;
    min-width: 0;
    max-width: var(--article-main-max-width);
    margin: 0;
    padding-inline: 0;
    padding-top: 0;
  }

  .post-page:not(:has(.post-sidebar)) {
    --post-layout-width: var(--article-main-max-width);
    grid-template-columns: minmax(0, 1fr);
  }

  .post-page:not(:has(.post-sidebar)) main.container {
    grid-column: 1;
  }

  .post-page .prose {
    width: 100%;
    max-width: min(var(--article-prose-width), 100%);
    margin-inline: auto;
  }

  article {
    padding: 2rem 2.25rem;
    border: var(--list-item-border-width) solid var(--border);
    border-radius: var(--radius-card);
    background: var(--list-item-surface);
    box-shadow: var(--shadow-card);
  }

  @supports (backdrop-filter: blur(1px)) {
    article {
      -webkit-backdrop-filter: blur(var(--list-item-blur));
      backdrop-filter: blur(var(--list-item-blur));
    }
  }

  /* Post header */
  .post-header {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: var(--article-main-width);
    margin: 0 auto 1.5rem;
    padding: 0;
  }

  .post-title {
    order: 2;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.6rem;
    color: var(--text);
  }

  @media (max-width: 768px) {
    article {
      padding: 1.25rem 1rem;
    }
  }

  .post-meta-row {
    order: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.7rem;
  }

  .post-tags-row {
    order: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-stats {
    order: 3;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-style: normal;
  }

  .post-stats-line {
    margin: 0;
  }

  /* Essay layout: centred headings, first-line indent like printed prose.
     Paragraphs that are only an image stay flush so pictures keep centred. */
  .post-story .post-header {
    text-align: center;
  }

  .post-story .post-meta-row,
  .post-story .post-tags-row {
    justify-content: center;
  }

  /* The prose column is narrower than the header, so centre it under the
     centred title instead of leaving it flush left. */
  .post-story .prose {
    margin-inline: auto;
  }

  .post-story .prose :global(h2),
  .post-story .prose :global(h3) {
    text-align: center;
    text-wrap: balance;
  }

  .post-story .prose > :global(p) {
    text-indent: 2em;
  }

  .post-story .prose > :global(p:has(> img:only-child)) {
    text-indent: 0;
  }

  /* Mobile TOC */
  .mobile-toc {
    display: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    background: var(--bg-card);
  }

  .mobile-toc summary {
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-toc summary::before {
    content: "▶";
    font-size: 0.65rem;
    transition: transform 150ms ease;
  }

  .mobile-toc[open] summary::before {
    transform: rotate(90deg);
  }

  /* Desktop TOC moves to its own right rail on wide screens. */
  .toc-sidebar {
    display: none;
    grid-column: 3;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    max-height: calc(100vh - var(--header-height) - 4rem);
    overflow-y: auto;
    align-self: start;
  }

  @media (min-width: 1280px) {
    .post-page:has(.post-sidebar):has(.toc-sidebar) {
      /* Same proportions as the home shell: equal rails, a capped main
         column, the same gap. */
      /* The home .shell spends 1.25rem a side on padding inside this width. */
      --post-layout-width: calc(var(--shell-width-wide) - 2.5rem);
      grid-template-columns:
        var(--rail-width) minmax(0, var(--main-max-width))
        var(--rail-width);
      gap: var(--shell-gap);
      justify-content: center;
    }

    .post-page:not(:has(.post-sidebar)):has(.toc-sidebar) {
      --post-layout-width: calc(
        var(--article-main-width) + var(--article-toc-width) + 2rem
      );
      grid-template-columns: minmax(0, var(--article-main-width)) var(
          --article-toc-width
        );
      justify-content: center;
    }

    .toc-sidebar {
      display: flex;
    }

    .mobile-toc {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .mobile-toc {
      display: block;
    }
  }

  @media (max-width: 1099px) {
    .post-page {
      display: block;
      width: 100%;
      padding-inline: 1.25rem;
    }

    .post-sidebar,
    .toc-sidebar {
      display: none;
    }

    main.container {
      max-width: var(--article-main-max-width);
      margin-inline: auto;
    }
  }
</style>

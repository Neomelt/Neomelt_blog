---
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Comments from "../blocks/view/Comments.astro";
import TableOfContents from "../blocks/widget/TableOfContents.astro";
import PostNavigation from "../blocks/view/PostNavigation.astro";
import SeriesNav from "../blocks/view/SeriesNav.astro";
import BaseLayout from "./BaseLayout.astro";
import Region from "../components/Region.astro";
import { siteLayout } from "../site.config";
import { getWalinePathForPost } from "../utils/waline";
import { getDefaultUiText, type UiTranslationKey } from "../i18n/ui";
import { resolvePostDates } from "../utils/post-dates";
import { estimateReadingTime } from "../utils/reading-time";
import { countMarkdownText, countTextUnits } from "../utils/text-count";
import { postTitleTransition } from "../utils/transition";
import { withBase } from "../utils/url";
import "../styles/md-components.css";

export interface Props {
  post: CollectionEntry<"blog">;
  headings: { depth: number; slug: string; text: string }[];
  /** Load the KaTeX stylesheet; set by utils/remark-math-flag. */
  hasMath?: boolean;
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const { post, headings, hasMath = false, prevPost, nextPost } = Astro.props;
const { title, description, tags } = post.data;
const { pubDate: resolvedPubDate, updatedDate: resolvedUpdatedDate } =
  await resolvePostDates(post);
const walinePath = getWalinePathForPost(post.id);
const shouldShowUpdated =
  resolvedUpdatedDate.valueOf() > resolvedPubDate.valueOf();

const wordCount = countTextUnits(title) + countMarkdownText(post.body || "");
const readingTime = estimateReadingTime(post.body || "");

const postType = post.data.type ?? "tech";
const typeLabelKey: UiTranslationKey =
  postType === "story" ? "common.essay" : "common.tech";
const category = (post.data.category ?? "").trim();

const shareImage =
  typeof post.data.heroImage === "object" && post.data.heroImage
    ? (post.data.heroImage as ImageMetadata)
    : undefined;

const hasSidebar = siteLayout.regions.asideStart.length > 0;
const hasToc = headings.some((h) => h.depth <= 3);
---

<BaseLayout
  title={title}
  description={description}
  katex={hasMath}
  image={shareImage}
  sidebar={false}
>
  <div class="post-page">
    {
      hasSidebar && (
        <aside class="post-sidebar">
          <Region name="asideStart" context={{ headings, post }} />
        </aside>
      )
    }

    <main class="container">
      <!-- Breadcrumb -->
      <nav
        class="breadcrumb"
        data-i18n-aria-label="post.breadcrumbAria"
        aria-label={getDefaultUiText("post.breadcrumbAria")}
      >
        <a href={withBase("/")} data-i18n="common.home"
          >{getDefaultUiText("common.home")}</a
        >
        <span class="breadcrumb-sep">/</span>
        <a href={withBase("/posts")} data-i18n="common.posts"
          >{getDefaultUiText("common.posts")}</a
        >
        <span class="breadcrumb-sep">/</span>
        <span>{title}</span>
      </nav>

      <article class:list={{ "post-story": postType === "story" }}>
        <header class="post-header">
          <div
            class="post-meta-row"
            data-i18n-aria-label="post.statsAria"
            aria-label={getDefaultUiText("post.statsAria")}
          >
            <span class="post-kind">
              <i class:list={["kind-dot", `is-${postType}`]} aria-hidden="true"
              ></i>
              <span data-i18n={typeLabelKey}>
                {getDefaultUiText(typeLabelKey)}
              </span>
              {
                category && (
                  <>
                    <span class="meta-sep">/</span>
                    <span>{category}</span>
                  </>
                )
              }
            </span>
            <span class="meta-sep">·</span>
            <FormattedDate date={resolvedPubDate} />
            <span class="meta-sep">·</span>
            <span>
              {wordCount}
              <span data-i18n="common.words"
                >{getDefaultUiText("common.words")}</span
              >
            </span>
            <span class="meta-sep">·</span>
            <span>
              {readingTime}
              <span data-i18n="common.minutes"
                >{getDefaultUiText("common.minutes")}</span
              >
            </span>
            <span class="meta-sep">·</span>
            <span>
              <span class="waline-pageview-count" data-path={walinePath}>0</span>
              <span data-i18n="common.views"
                >{getDefaultUiText("common.views")}</span
              >
            </span>
            {
              shouldShowUpdated && (
                <>
                  <span class="meta-sep">·</span>
                  <span>
                    <span data-i18n="common.updatedAt">
                      {getDefaultUiText("common.updatedAt")}
                    </span>{" "}
                    <FormattedDate date={resolvedUpdatedDate} />
                  </span>
                </>
              )
            }
          </div>

          <h1 class="post-title" style={postTitleTransition(post.id)}>
            {title}
          </h1>

          {
            description && (
              <p class="post-lead">
                <span>{description}</span>
              </p>
            )
          }
        </header>

        <!-- Mobile TOC (collapsible) -->
        {
          hasToc && (
            <details class="mobile-toc">
              <summary data-i18n="common.toc">
                {getDefaultUiText("common.toc")}
              </summary>
              <TableOfContents headings={headings} />
            </details>
          )
        }

        <!-- Post content -->
        <div class="prose">
          <slot />
        </div>

        {
          tags && tags.length > 0 && (
            <div class="post-tags-row">
              {tags.map((tag: string) => (
                <a href={withBase(`/tags#${tag}`)} class="tag">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <SeriesNav post={post} />
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
        <Comments path={walinePath} />
      </article>
    </main>

    {
      hasToc && (
        <aside class="toc-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  import "../scripts/md-components";
</script>

<style>
  .post-page {
    --post-layout-width: var(--article-shell-width);
    display: grid;
    grid-template-columns: clamp(200px, 16vw, var(--aside-width)) minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    width: min(calc(100% - 2.5rem), var(--post-layout-width));
    margin-inline: auto;
    padding-top: 0;
  }

  .post-sidebar {
    --widget-scale: var(--rail-text-scale);
    font-size: calc(1em * var(--widget-scale));
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    min-width: 0;
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow-y: auto;
    align-self: start;
    padding-block: 1.75rem;
  }

  .post-sidebar > :global(* + *) {
    padding-top: 1.25rem;
    border-top: var(--border-width) solid var(--border);
  }

  main.container {
    grid-column: 2;
    width: 100%;
    min-width: 0;
    max-width: var(--article-main-max-width);
    margin: 0;
    padding-inline: 0;
  }

  .post-page:not(:has(.post-sidebar)) {
    --post-layout-width: var(--article-main-max-width);
    grid-template-columns: minmax(0, 1fr);
  }

  .post-page:not(:has(.post-sidebar)) main.container {
    grid-column: 1;
  }

  .post-page .prose {
    width: 100%;
    max-width: min(var(--prose-width), 100%);
    margin-inline: auto;
  }

  article {
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .post-header {
    width: 100%;
    max-width: var(--article-main-width);
    margin: 0 auto 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }

  .post-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .kind-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .kind-dot.is-tech {
    background: var(--accent);
  }

  .kind-dot.is-story {
    background: var(--badge-text);
  }

  .meta-sep {
    opacity: 0.45;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.012em;
    margin: 0;
    color: var(--text);
    text-wrap: balance;
  }

  .post-lead {
    margin: 1.05rem 0 0;
    padding: 0.82rem 1.05rem;
    background: var(--bg-card);
    border-left: 2.5px solid var(--accent);
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.78;
  }

  .post-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  /* Essay layout: centred headings, first-line indent like printed prose. */
  .post-story .post-header {
    text-align: center;
  }

  .post-story .post-meta-row {
    justify-content: center;
  }

  .post-story .post-lead {
    justify-content: center;
    text-align: left;
  }

  .post-story .prose {
    margin-inline: auto;
  }

  .post-story .prose :global(h2),
  .post-story .prose :global(h3) {
    text-align: center;
    text-wrap: balance;
  }

  .post-story .prose > :global(p) {
    text-indent: 2em;
  }

  .post-story .prose > :global(p:has(> img:only-child)) {
    text-indent: 0;
  }

  /* Mobile TOC */
  .mobile-toc {
    display: none;
    border-block: 1px solid var(--border);
    padding: 0.7rem 0;
    margin-bottom: 1.75rem;
    background: transparent;
  }

  .mobile-toc summary {
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-toc summary::before {
    content: "▶";
    font-size: 0.65rem;
    transition: transform 150ms ease;
  }

  .mobile-toc[open] summary::before {
    transform: rotate(90deg);
  }

  /* Desktop TOC moves to its own right rail on wide screens. */
  .toc-sidebar {
    display: none;
    grid-column: 3;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - 3rem);
    overflow-y: auto;
    align-self: start;
    padding-top: 2rem;
  }

  @media (min-width: 1280px) {
    .post-page:has(.post-sidebar):has(.toc-sidebar) {
      --post-layout-width: calc(var(--shell-width-wide) - 2.5rem);
      grid-template-columns:
        var(--rail-width) minmax(0, var(--main-max-width))
        var(--article-toc-width);
      gap: var(--shell-gap);
      justify-content: center;
    }

    .post-page:not(:has(.post-sidebar)):has(.toc-sidebar) {
      --post-layout-width: calc(
        var(--article-main-width) + var(--article-toc-width) + 2rem
      );
      grid-template-columns: minmax(0, var(--article-main-width)) var(
          --article-toc-width
        );
      justify-content: center;
    }

    .toc-sidebar {
      display: flex;
    }

    .mobile-toc {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .mobile-toc {
      display: block;
    }
  }

  @media (max-width: 1099px) {
    .post-page {
      display: block;
      width: 100%;
      padding-inline: 1.25rem;
    }

    .post-sidebar,
    .toc-sidebar {
      display: none;
    }

    main.container {
      max-width: var(--article-main-max-width);
      margin-inline: auto;
    }
  }
</style>

---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../blocks/chrome/Footer.astro";
import Header from "../blocks/chrome/Header.astro";
import CodeCopyButton from "../blocks/behavior/CodeCopyButton.astro";
import WalineCounter from "../blocks/behavior/WalineCounter.astro";
import Region from "../components/Region.astro";
import { siteLayout } from "../site.config";
import type { ImageMetadata } from "astro";
import type { BlockPlacement, RegionName } from "../types/layout";
import {
  DEFAULT_LOCALE,
  LOCALE_STORAGE_KEY,
  UI_TRANSLATIONS,
} from "../i18n/ui";

export interface Props {
  title: string;
  description?: string;
  /** Load the KaTeX stylesheet — only needed on post pages that contain math. */
  katex?: boolean;
  /** Share image. Falls back to the site-wide card when omitted. */
  image?: ImageMetadata;
  /**
   * Per-page region overrides. Omit a region to use site.config.ts; pass an
   * empty array to render nothing there on this page.
   */
  regions?: Partial<Record<RegionName, BlockPlacement[]>>;
  /**
   * Render the aside column beside the content. Off for pages that build
   * their own columns - BlogPost puts the table of contents in one.
   */
  sidebar?: boolean;
}

const {
  title,
  description = "",
  katex = false,
  image,
  regions = {},
  sidebar = true,
} = Astro.props;

const startBlocks = regions.asideStart ?? siteLayout.regions.asideStart;
const endBlocks = regions.asideEnd ?? siteLayout.regions.asideEnd;
const hasStart = sidebar && startBlocks.length > 0;
const hasEnd = sidebar && endBlocks.length > 0;
const withSidebar = hasStart || hasEnd;
---

<!doctype html>
<html lang="zh-CN" data-skin={siteLayout.skin} data-layout={siteLayout.layout}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    {
      katex && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
          integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <script
      define:vars={{
        defaultLocale: DEFAULT_LOCALE,
        localeStorageKey: LOCALE_STORAGE_KEY,
        uiTranslations: UI_TRANSLATIONS,
      }}
    >
      (() => {
        const normalizeLocale = (value) => (value === "en" ? "en" : "zh");

        const getStoredLocale = () => {
          try {
            return localStorage.getItem(localeStorageKey);
          } catch {
            return null;
          }
        };

        const setStoredLocale = (locale) => {
          try {
            localStorage.setItem(localeStorageKey, locale);
          } catch {
            // Ignore storage errors (private mode, disabled storage, etc.)
          }
        };

        const t = (key, locale, fallback = "") => {
          const langDict = uiTranslations[locale] || uiTranslations.zh || {};
          const zhDict = uiTranslations.zh || {};
          if (Object.prototype.hasOwnProperty.call(langDict, key))
            return langDict[key];
          if (Object.prototype.hasOwnProperty.call(zhDict, key))
            return zhDict[key];
          return fallback || key;
        };

        const applyToDom = (locale) => {
          document.documentElement.setAttribute(
            "lang",
            locale === "en" ? "en" : "zh-CN",
          );
          document.documentElement.dataset.locale = locale;

          document.querySelectorAll("[data-i18n]").forEach((element) => {
            const key = element.getAttribute("data-i18n");
            if (!key) return;
            element.textContent = t(key, locale, element.textContent || "");
          });

          document
            .querySelectorAll("[data-i18n-aria-label]")
            .forEach((element) => {
              const key = element.getAttribute("data-i18n-aria-label");
              if (!key) return;
              element.setAttribute(
                "aria-label",
                t(key, locale, element.getAttribute("aria-label") || ""),
              );
            });

          document
            .querySelectorAll("[data-i18n-placeholder]")
            .forEach((element) => {
              const key = element.getAttribute("data-i18n-placeholder");
              if (!key) return;
              if ("placeholder" in element) {
                element.placeholder = t(key, locale, element.placeholder || "");
              }
            });

          document.dispatchEvent(
            new CustomEvent("site:locale-change", {
              detail: { locale },
            }),
          );
        };

        let currentLocale = normalizeLocale(getStoredLocale() || defaultLocale);

        const setLocale = (locale) => {
          const normalized = normalizeLocale(locale);
          currentLocale = normalized;
          setStoredLocale(normalized);
          applyToDom(normalized);
          return normalized;
        };

        const getLocale = () => currentLocale;
        const toggleLocale = () =>
          setLocale(currentLocale === "zh" ? "en" : "zh");

        window.__siteI18n = {
          t: (key, fallback = "") => t(key, currentLocale, fallback),
          getLocale,
          setLocale,
          toggleLocale,
        };

        const syncLocale = () => {
          const stored = normalizeLocale(getStoredLocale() || currentLocale);
          currentLocale = stored;
          applyToDom(stored);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", syncLocale, {
            once: true,
          });
        } else {
          syncLocale();
        }
        document.addEventListener("astro:page-load", syncLocale);
      })();
    </script>
    <Region name="backdrop" override={regions.backdrop} />
    <slot name="header"><Header /></slot>
    <div class="masthead">
      <Region name="masthead" override={regions.masthead} />
    </div>
    {
      withSidebar ? (
        <div class="shell">
          {
            hasStart && (
              <aside class="shell-aside start">
                <Region name="asideStart" override={regions.asideStart} />
              </aside>
            )
          }
          <div class="shell-main">
            <slot />
          </div>
          {
            hasEnd && (
              <aside class="shell-aside end">
                <Region name="asideEnd" override={regions.asideEnd} />
              </aside>
            )
          }
        </div>
      ) : (
        <slot />
      )
    }
    <WalineCounter />
    <CodeCopyButton />
    <Region name="floating" override={regions.floating} />
    <slot name="footer"><Footer /></slot>
  </body>
</html>

<style is:global>
  /* Empty under a skin that places nothing here, and :empty then collapses
     the top margin the header leaves behind. */
  .masthead:not(:empty) {
    max-width: var(--content-width);
    margin: 0 auto;
    /* No header offset: #site-header is sticky, so it already takes up flow.
       Reserving its height here as well is what put a dark band between the
       header and the banner. */
    padding: 0 1.25rem;
    /* A full-bleed child escapes this box with a negative margin, which would
       otherwise be clipped or add a horizontal scrollbar. */
    overflow: visible;
  }

  /* main already clears the fixed header; with a masthead above it that
     offset would be counted twice. */
  body:has(.masthead:not(:empty)) main {
    padding-top: 0;
  }

  /* Two-column shell. The reference blogs run content beside a persistent
     sidebar rather than a single centred column, which is most of why a
     one-column page reads as sparse. */
  /* Pulled up over the banner, and given its own surface so the image does
     not show through the gaps between cards. z-index keeps it above the
     banner it overlaps. */
  .shell,
  body:has(.masthead:not(:empty)) main {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--content-overlap));
    border-start-start-radius: var(--radius-card);
    border-start-end-radius: var(--radius-card);
  }

  body:has(.masthead:not(:empty)) .shell,
  body:has(.masthead:not(:empty)) main {
    background: var(--bg);
    padding-top: var(--content-overlap);
  }

  .shell {
    display: flex;
    align-items: flex-start;
    gap: var(--shell-gap);
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-inline: 1.25rem;
  }

  /* Widen only when both columns are present. :has keeps this in CSS instead
     of the layout having to count them. */
  .shell:has(.shell-aside.start):has(.shell-aside.end) {
    max-width: var(--shell-width-wide);
  }

  .shell-main {
    flex: 1;
    min-width: 0;
  }

  /* .container centres itself with margin auto, which inside a flex row eats
     the free space and pins the sidebar to the viewport edge - the same trap
     BlogPost documents for its ToC column. */
  .shell-main .container {
    max-width: none;
    margin: 0;
    padding-inline: 0;
  }

  /* A column exists only when its region has blocks, so the shell is one,
     two or three wide without any of them knowing about the others. */
  .shell-aside {
    width: var(--aside-width);
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: calc(var(--header-height) + 3rem) 3rem;
  }

  @media (max-width: 1099px) {
    .shell {
      display: block;
    }

    .shell-aside {
      display: none;
    }
  }
</style>

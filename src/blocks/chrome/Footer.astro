---
import { SITE_START_DATE as startDate, SITE_TITLE } from "../../consts";
import { getDefaultUiText, UI_TRANSLATIONS } from "../../i18n/ui";
import { profile } from "../../site.config";
import { TELEGRAM_LOG_ENABLED } from "../../utils/telegram-log";
import { withBase } from "../../utils/url";

const runtimeFallbacks = {
  "footer.running": getDefaultUiText("footer.running"),
  "footer.day": getDefaultUiText("footer.day"),
  "footer.hour": getDefaultUiText("footer.hour"),
  "footer.minute": getDefaultUiText("footer.minute"),
  "footer.second": getDefaultUiText("footer.second"),
  enDay: UI_TRANSLATIONS.en["footer.day"],
  enHour: UI_TRANSLATIONS.en["footer.hour"],
  enMinute: UI_TRANSLATIONS.en["footer.minute"],
  enSecond: UI_TRANSLATIONS.en["footer.second"],
} as const;
---

<footer id="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={withBase("/")} class="footer-title">{SITE_TITLE}</a>
        <p class="footer-bio" data-i18n={profile.bioKey}>
          {getDefaultUiText(profile.bioKey)}
        </p>
        <p class="footer-runtime">
          <span data-i18n="footer.running"
            >{runtimeFallbacks["footer.running"]}</span
          >
          <span id="runtime-display" data-start={startDate.toISOString()}
            >...</span
          >
        </p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h3 class="footer-col-title" data-i18n="footer.colNav">
            {getDefaultUiText("footer.colNav")}
          </h3>
          <ul>
            <li>
              <a href={withBase("/posts")} data-i18n="header.posts"
                >{getDefaultUiText("header.posts")}</a
              >
            </li>
            {
              TELEGRAM_LOG_ENABLED && (
                <li>
                  <a href={withBase("/log")} data-i18n="header.log">
                    {getDefaultUiText("header.log")}
                  </a>
                </li>
              )
            }
            <li>
              <a href={withBase("/posts/archive")} data-i18n="header.archive"
                >{getDefaultUiText("header.archive")}</a
              >
            </li>
            <li>
              <a href={withBase("/friends")} data-i18n="header.friends"
                >{getDefaultUiText("header.friends")}</a
              >
            </li>
            <li>
              <a href={withBase("/about")} data-i18n="header.about"
                >{getDefaultUiText("header.about")}</a
              >
            </li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-col-title" data-i18n="footer.colConnect">
            {getDefaultUiText("footer.colConnect")}
          </h3>
          <ul>
            {
              profile.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    {...(link.url.startsWith("http")
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href={withBase("/rss.xml")}>RSS</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-col-title" data-i18n="footer.colExplore">
            {getDefaultUiText("footer.colExplore")}
          </h3>
          <ul>
            <li>
              <a href={withBase("/tags")} data-i18n="header.tags"
                >{getDefaultUiText("header.tags")}</a
              >
            </li>
            <li>
              <a href={withBase("/series")} data-i18n="series.title"
                >{getDefaultUiText("series.title")}</a
              >
            </li>
            <li>
              <a href={withBase("/terms/list")} data-i18n="footer.sitePolicy"
                >{getDefaultUiText("footer.sitePolicy")}</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© {new Date().getFullYear()} {profile.name}</span>
      <a
        href="https://astro.build/"
        target="_blank"
        rel="noopener"
        class="footer-powered"
        data-i18n="footer.themePowered"
      >
        {getDefaultUiText("footer.themePowered")}
      </a>
    </div>
  </div>
</footer>

<script define:vars={{ runtimeFallbacks }}>
  const getI18n = () => window.__siteI18n;
  const fallback = (key) => runtimeFallbacks[key] || key;
  const formatRuntime = (days, hours, minutes, seconds) => {
    const i18n = getI18n();
    const locale = i18n?.getLocale?.() === "en" ? "en" : "zh";
    if (locale === "en") {
      return `${days}${i18n?.t?.("footer.day", fallback("enDay")) || fallback("enDay")} ${hours}${i18n?.t?.("footer.hour", fallback("enHour")) || fallback("enHour")} ${minutes}${i18n?.t?.("footer.minute", fallback("enMinute")) || fallback("enMinute")} ${seconds}${i18n?.t?.("footer.second", fallback("enSecond")) || fallback("enSecond")}`;
    }
    return `${days} ${i18n?.t?.("footer.day", fallback("footer.day")) || fallback("footer.day")} ${hours} ${i18n?.t?.("footer.hour", fallback("footer.hour")) || fallback("footer.hour")} ${minutes} ${i18n?.t?.("footer.minute", fallback("footer.minute")) || fallback("footer.minute")} ${seconds} ${i18n?.t?.("footer.second", fallback("footer.second")) || fallback("footer.second")}`;
  };

  function updateRuntime() {
    const el = document.getElementById("runtime-display");
    if (!el) return;
    const start = new Date(el.dataset.start || "2025-08-13");
    const now = new Date();
    const diff = now.getTime() - start.getTime();
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    el.textContent = formatRuntime(d, h, m, s);
  }

  function initRuntimeTicker() {
    updateRuntime();
    if (!window.__footerRuntimeInterval) {
      window.__footerRuntimeInterval = window.setInterval(updateRuntime, 1000);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRuntimeTicker, {
      once: true,
    });
  } else {
    initRuntimeTicker();
  }

  document.addEventListener("astro:page-load", initRuntimeTicker);
  document.addEventListener("site:locale-change", updateRuntime);
</script>

<style>
  #site-footer {
    border-top: var(--border-width) solid var(--border);
    margin-top: auto;
    padding: 3rem 0 1.75rem;
  }

  .footer-inner {
    max-width: min(
      var(--shell-width-wide),
      calc(
        2 * var(--rail-width) + var(--main-max-width) + 2 * var(--shell-gap) +
          2.5rem
      )
    );
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr);
    gap: 2.5rem;
    padding-bottom: 2.25rem;
  }

  .footer-title {
    display: inline-block;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.45rem;
  }

  .footer-title:hover {
    color: var(--accent);
  }

  .footer-bio {
    margin: 0 0 0.85rem;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .footer-runtime {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    opacity: 0.78;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer-col-title {
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-top: 1.25rem;
    border-top: var(--border-width) solid
      color-mix(in srgb, var(--border) 62%, transparent);
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  .footer-powered {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-powered:hover {
    color: var(--accent);
  }

  @media (max-width: 680px) {
    #site-footer {
      padding: 2.25rem 0 1.5rem;
    }

    .footer-inner {
      padding: 0 1.1rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>

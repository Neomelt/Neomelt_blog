---
import { SITE_TITLE } from "../../consts";
import { getDefaultUiText, UI_TRANSLATIONS } from "../../i18n/ui";
import { withBase } from "../../utils/url";
import SearchModal from "../../components/SearchModal.astro";
import ReaderSettings from "./ReaderSettings.astro";

const defaultLocaleLabelZh = getDefaultUiText("locale.label");
const defaultLocaleLabelEn = UI_TRANSLATIONS.en["locale.label"];
---

<header id="site-header">
  <div class="header-inner">
    <!-- Site title -->
    <a
      href={withBase("/")}
      class="site-title"
      data-i18n-aria-label="header.homeAria"
      aria-label={getDefaultUiText("header.homeAria")}
    >
      {SITE_TITLE}
    </a>

    <!-- Desktop nav -->
    <nav
      class="nav-links"
      id="nav-links"
      data-i18n-aria-label="header.mainNavAria"
      aria-label={getDefaultUiText("header.mainNavAria")}
    >
      <a href={withBase("/posts")} class="nav-link" data-i18n="header.posts"
        >{getDefaultUiText("header.posts")}</a
      >
      <a
        href={withBase("/posts/archive")}
        class="nav-link"
        data-i18n="header.archive">{getDefaultUiText("header.archive")}</a
      >
      <a href={withBase("/tags")} class="nav-link" data-i18n="header.tags"
        >{getDefaultUiText("header.tags")}</a
      >
      <a href={withBase("/friends")} class="nav-link" data-i18n="header.friends"
        >{getDefaultUiText("header.friends")}</a
      >
      <a href={withBase("/about")} class="nav-link" data-i18n="header.about"
        >{getDefaultUiText("header.about")}</a
      >
    </nav>

    <!-- Right controls -->
    <div class="nav-controls">
      <!-- Search -->
      <button
        id="search-toggle"
        class="icon-btn"
        data-i18n-aria-label="header.searchAria"
        aria-label={getDefaultUiText("header.searchAria")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path>
        </svg>
      </button>

      <!-- Language toggle -->
      <button
        id="locale-toggle"
        class="icon-btn locale-btn"
        data-i18n-aria-label="header.languageAria"
        aria-label={getDefaultUiText("header.languageAria")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20"></path>
          <path d="M12 2a15 15 0 0 1 0 20"></path>
          <path d="M12 2a15 15 0 0 0 0 20"></path>
        </svg>
        <span
          id="locale-toggle-label"
          class="locale-label"
          data-i18n="locale.label">{getDefaultUiText("locale.label")}</span
        >
      </button>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="icon-btn"
        data-i18n-aria-label="header.themeAria"
        aria-label={getDefaultUiText("header.themeAria")}
      >
        <!-- Moon (shown in light mode) -->
        <svg
          id="moon-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <!-- Sun (shown in dark mode) -->
        <svg
          id="sun-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          style="display:none"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!--
        One button where the skin and layout toggles used to be. Those two
        could only cycle - reaching a named skin or layout meant clicking
        until it came round - and they cost two slots to expose two of the
        four axes. This opens the palette, which addresses every axis by
        name, shows which value is current, and has room for the next
        setting without taking another slot in the header.
      -->
      <button
        id="settings-toggle"
        class="icon-btn"
        data-i18n-aria-label="header.settingsAria"
        aria-label={getDefaultUiText("header.settingsAria")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h10M18 18h2"></path>
          <circle cx="16" cy="6" r="2"></circle>
          <circle cx="8" cy="12" r="2"></circle>
          <circle cx="16" cy="18" r="2"></circle>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        class="icon-btn mobile-only"
        data-i18n-aria-label="header.menuAria"
        aria-label={getDefaultUiText("header.menuAria")}
        aria-expanded="false"
      >
        <svg
          id="menu-open-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          id="menu-close-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          style="display:none"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav drawer: closed state is display:none (already outside the
       a11y tree), so no aria-hidden here — a static one would keep the open
       drawer invisible to screen readers. -->
  <div id="mobile-nav" class="mobile-nav">
    <a
      href={withBase("/posts")}
      class="mobile-nav-link"
      data-i18n="header.posts">{getDefaultUiText("header.posts")}</a
    >
    <a
      href={withBase("/posts/archive")}
      class="mobile-nav-link"
      data-i18n="header.archive">{getDefaultUiText("header.archive")}</a
    >
    <a href={withBase("/tags")} class="mobile-nav-link" data-i18n="header.tags"
      >{getDefaultUiText("header.tags")}</a
    >
    <a
      href={withBase("/friends")}
      class="mobile-nav-link"
      data-i18n="header.friends">{getDefaultUiText("header.friends")}</a
    >
    <a
      href={withBase("/about")}
      class="mobile-nav-link"
      data-i18n="header.about">{getDefaultUiText("header.about")}</a
    >
  </div>
</header>

<SearchModal />
<ReaderSettings />

<script define:vars={{ defaultLocaleLabelZh, defaultLocaleLabelEn }}>
  // ---- Theme ----
  function getThemeApi() {
    return window.__siteTheme;
  }

  function getTheme() {
    return getThemeApi()?.getTheme?.() || "dark";
  }

  function applyTheme(theme) {
    const normalizedTheme =
      getThemeApi()?.applyTheme?.(theme) ||
      (theme === "light" ? "light" : "dark");
    const moon = document.getElementById("moon-icon");
    const sun = document.getElementById("sun-icon");
    if (normalizedTheme === "dark") {
      moon && (moon.style.display = "none");
      sun && (sun.style.display = "");
    } else {
      moon && (moon.style.display = "");
      sun && (sun.style.display = "none");
    }

    return normalizedTheme;
  }

  // Apply on load (also runs before DOMContentLoaded via inline script in BaseHead)
  applyTheme(getTheme());

  function initHeader() {
    applyTheme(getTheme());

    const themeToggle = document.getElementById("theme-toggle");
    if (themeToggle && !themeToggle.dataset.bound) {
      themeToggle.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        applyTheme(isDark ? "light" : "dark");
      });
      themeToggle.dataset.bound = "true";
    }

    // Skin and layout are no longer toggles here - #settings-toggle opens the
    // reading panel, which binds it. __siteTheme.cycleSkin/cycleLayout are
    // still exported and still work; nothing in this file calls them.

    // ---- Mobile menu ----
    const menuToggle = document.getElementById("menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (menuToggle && !menuToggle.dataset.bound) {
      menuToggle.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("open");
        menuToggle.setAttribute("aria-expanded", String(isOpen));
        if (openIcon) openIcon.style.display = isOpen ? "none" : "";
        if (closeIcon) closeIcon.style.display = isOpen ? "" : "none";
      });
      menuToggle.dataset.bound = "true";
    }

    // ---- Locale toggle ----
    const localeToggle = document.getElementById("locale-toggle");

    const updateLocaleLabel = () => {
      const i18n = window.__siteI18n;
      const locale = i18n?.getLocale?.() === "en" ? "en" : "zh";
      const localeLabel = document.getElementById("locale-toggle-label");
      if (!localeLabel) return;
      const fallback =
        locale === "en" ? defaultLocaleLabelEn : defaultLocaleLabelZh;
      localeLabel.textContent = i18n?.t?.("locale.label", fallback) || fallback;
    };

    if (localeToggle && !localeToggle.dataset.bound) {
      localeToggle.addEventListener("click", () => {
        const i18n = window.__siteI18n;
        i18n?.toggleLocale?.();
        updateLocaleLabel();
      });
      localeToggle.dataset.bound = "true";
    }

    const previousLocaleHandler = window.__headerLocaleHandler;
    if (previousLocaleHandler) {
      document.removeEventListener("site:locale-change", previousLocaleHandler);
    }
    document.addEventListener("site:locale-change", updateLocaleLabel);
    window.__headerLocaleHandler = updateLocaleLabel;
    updateLocaleLabel();

    // ---- Active nav link ----
    const path = window.location.pathname;
    document.querySelectorAll(".nav-link, .mobile-nav-link").forEach((link) => {
      link.classList.remove("active");
      const href = link.getAttribute("href") || "";
      if (href !== "/" && path.startsWith(href)) {
        link.classList.add("active");
      } else if (href === "/" && path === "/") {
        link.classList.add("active");
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initHeader);
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  /* The same glass tokens the sidebar cards use, not a flat --bg. With a
     backdrop behind the page, an opaque bar was the one element the artwork
     could not show through - it cut the illustration off at the top and read
     as a strip pasted over the design rather than part of it.

     This is free under minimal: that skin sets --glass-blur-md to 0 and
     --glass-bg to the opaque card colour, so the header renders exactly as
     it did. Only anime, which has a backdrop to show, changes. */
  #site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--glass-bg);
    border-bottom: var(--border-width) solid var(--glass-border);
    height: var(--header-height);
    overflow: hidden;
  }

  /* backdrop-filter only inside @supports, matching surface/GlassPanel:
     without it the declared background has to stay fully opaque, or an
     unsupported browser shows the header text straight over the artwork. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    #site-header {
      -webkit-backdrop-filter: blur(var(--glass-blur-md))
        saturate(var(--glass-saturate));
      backdrop-filter: blur(var(--glass-blur-md))
        saturate(var(--glass-saturate));
    }
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .site-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 0;
    justify-self: start;
  }

  .site-title:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    justify-self: center;
    white-space: nowrap;
  }

  .nav-link {
    font-size: 1rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    background: var(--bg-code);
  }

  .nav-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    justify-self: end;
    min-width: 0;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .icon-btn:hover {
    color: var(--text);
    background: var(--bg-code);
  }

  /* Wider than the icon buttons because it carries a word, but otherwise the
     same control. It used to be the only bordered thing in the row, which
     made four controls read as three shapes. The label stays - a globe alone
     does not say which language a click would switch to. */
  .locale-btn {
    width: auto;
    padding: 0 0.5rem;
    gap: 0.35rem;
  }

  .locale-label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* Mobile nav drawer */
  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1.25rem 1rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav-link {
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--accent);
  }

  /* Show mobile toggle only on small screens */
  .mobile-only {
    display: none;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
    .mobile-only {
      display: flex;
    }
    #site-header {
      height: auto;
      min-height: var(--header-height);
    }
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      height: var(--header-height);
      padding: 0 0.75rem;
      gap: 0.5rem;
    }
    .site-title {
      font-size: clamp(1.15rem, 5vw, 1.45rem);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-controls {
      gap: 0.15rem;
    }
    .icon-btn {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-md);
      flex-shrink: 0;
    }
    .locale-btn {
      width: 32px;
      padding: 0;
      gap: 0;
      border: none;
    }
    .locale-label {
      display: none;
    }
    .mobile-nav {
      padding: 0.35rem 0.9rem 0.75rem;
    }
  }

  @media (max-width: 360px) {
    .header-inner {
      padding: 0 0.55rem;
      gap: 0.35rem;
    }
    .site-title {
      font-size: 1.05rem;
    }
    .icon-btn {
      width: 30px;
      height: 30px;
    }
  }
</style>

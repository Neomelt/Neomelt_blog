---
import { getCollection } from "astro:content";
import GlassPanel from "../surface/GlassPanel.astro";
import { getDefaultUiText } from "../../i18n/ui";
import { withBase } from "../../utils/url";

export interface Props {
  /** Cap on how many tags to show, most-used first. */
  limit?: number;
  heading?: boolean;
}

const { limit = 24, heading = true } = Astro.props;

const posts = await getCollection("blog", ({ data }) => !data.hidden);

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const ranked = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, limit);
---

<GlassPanel class="cloud">
  {
    heading && (
      <div class="cloud-head">
        <h2 class="cloud-title" data-i18n="sidebar.tags">
          {getDefaultUiText("sidebar.tags")}
        </h2>
        <span class="cloud-sub">#{counts.size}</span>
      </div>
    )
  }
  <div class="cloud-body">
    {
      ranked.map(([name, count]) => (
        <a
          href={`${withBase("/tags")}#${name}`}
          class="cloud-tag"
          title={`${name} (${count})`}
        >
          <span class="tag-hash">#</span>
          <span>{name}</span>
          <sup class="tag-sup">{count}</sup>
        </a>
      ))
    }
  </div>
  {
    counts.size > limit && (
      <a href={withBase("/tags")} class="cloud-more" data-i18n="sidebar.more">
        {getDefaultUiText("sidebar.more")}
      </a>
    )
  }
</GlassPanel>

<style>
  .cloud-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .cloud-title {
    margin: 0;
    font-size: calc(0.88rem * var(--widget-scale, 1));
    font-weight: 700;
    color: var(--text);
  }

  .cloud-sub {
    font-family: var(--font-mono);
    font-size: calc(0.68rem * var(--widget-scale, 1));
    color: var(--text-muted);
    opacity: 0.75;
  }

  .cloud-body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.36rem 0.68rem;
  }

  .cloud-tag {
    font-size: calc(0.82rem * var(--widget-scale, 1));
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.5;
    transition: color var(--transition);
  }

  .cloud-tag:hover {
    color: var(--accent);
  }

  .tag-hash {
    opacity: 0.55;
    margin-right: 1px;
  }

  .tag-sup {
    font-family: var(--font-mono);
    font-size: calc(0.64rem * var(--widget-scale, 1));
    opacity: 0.68;
    margin-left: 2px;
  }

  .cloud-more {
    display: inline-block;
    margin-top: 0.65rem;
    font-family: var(--font-mono);
    font-size: calc(0.75rem * var(--widget-scale, 1));
    color: var(--accent);
    text-decoration: none;
  }

  .cloud-more:hover {
    text-decoration: underline;
  }
</style>

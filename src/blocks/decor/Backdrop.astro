---
import { withBase } from "../../utils/url";

/**
 * Full-screen layer behind everything. Two reasons it exists:
 * a skin's biggest visual move is what sits behind the page, and glass
 * surfaces have nothing to refract without it.
 *
 * Defaults to a pure-CSS gradient so it works with no assets at all. Point
 * `src` at an illustration in public/ when you have one - the overlay and
 * blur controls are there because a busy image destroys text contrast, and
 * that trade-off should be tunable rather than discovered later.
 */
export interface Props {
  /** Root-absolute path to an image in public/. Omit for the gradient. */
  src?: string;
  /** 0-1. How much flat page colour to lay over the image for contrast. */
  overlay?: number;
  /** Blur radius in px applied to the image, softening detail behind text. */
  blur?: number;
  /** Slow drift. Off by default; always off under reduced-motion. */
  drift?: boolean;
}

const { src, overlay = 0.55, blur = 0, drift = false } = Astro.props;
const imageUrl = src ? withBase(src) : null;
---

<div class:list={["backdrop", { drift }]} aria-hidden="true">
  {
    imageUrl && (
      <div
        class="backdrop-image"
        style={`background-image: url("${imageUrl}"); filter: blur(${blur}px);`}
      />
    )
  }
  <div class="backdrop-wash" style={`opacity: ${overlay}`}></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* The gradient shows through wherever there is no image, and is the
       whole backdrop when src is omitted. Colours are tokens, so it
       re-tints with the skin instead of being locked to one look. */
    /* Layered rather than one gradient: a top-anchored wash gives the page a
       horizon, and two offset blooms keep it from banding. axi404.top gets
       its atmosphere the same way - linear-gradient(#659EB966, transparent)
       over the page - with no image at all. */
    background:
      linear-gradient(
        180deg,
        rgba(var(--accent-rgb), 0.16) 0%,
        rgba(var(--accent-rgb), 0.04) 22%,
        rgba(var(--accent-rgb), 0) 46%
      ),
      radial-gradient(
        ellipse 90% 55% at 12% 4%,
        rgba(var(--accent-rgb), 0.22) 0%,
        rgba(var(--accent-rgb), 0) 58%
      ),
      radial-gradient(
        ellipse 70% 50% at 88% 26%,
        rgba(var(--ink-rgb), 0.16) 0%,
        rgba(var(--ink-rgb), 0) 55%
      ),
      var(--bg);
  }

  .backdrop-image {
    position: absolute;
    /* Overscan so the blur does not reveal the edges. */
    inset: -4%;
    background-size: cover;
    background-position: center;
  }

  .backdrop-wash {
    position: absolute;
    inset: 0;
    background: var(--bg);
  }

  .drift .backdrop-image {
    animation: backdrop-drift 48s ease-in-out infinite alternate;
  }

  @keyframes backdrop-drift {
    from {
      transform: scale(1.04) translate3d(-1%, -0.5%, 0);
    }
    to {
      transform: scale(1.08) translate3d(1%, 0.5%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift .backdrop-image {
      animation: none;
    }
  }
</style>

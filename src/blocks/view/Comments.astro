---
import { normalizeWalinePath } from "../../utils/waline";
import { getDefaultUiText } from "../../i18n/ui";
import { withBase } from "../../utils/url";
import { WALINE_CLIENT_SCRIPT_URLS } from "../../utils/waline-loader";

interface Props {
  path?: string;
}

const { path = Astro.url.pathname } = Astro.props;
const walinePath = normalizeWalinePath(path);
const serverURL = (import.meta.env.PUBLIC_WALINE_SERVER_URL ?? "").trim();
const walineCssHref = withBase("/vendor/waline.css");
const walineScriptUrlsJson = JSON.stringify(WALINE_CLIENT_SCRIPT_URLS);
const commentsFallbacks = {
  loadFailedPrefix: getDefaultUiText("comments.loadFailedPrefix"),
  noServerPrefix: getDefaultUiText("comments.noServerPrefix"),
};
---

<div
  class="comments-wrapper"
  data-waline-css={walineCssHref}
  data-waline-scripts={walineScriptUrlsJson}
>
  {
    serverURL ? (
      <>
        <div
          id="waline"
          data-waline-path={walinePath}
          data-server-url={serverURL}
        />
        <div
          id="waline-fallback"
          class="comments-config-tip"
          style="display: none;"
        >
          {commentsFallbacks.loadFailedPrefix}{" "}
          <a href={"https://www.neomelt.cloud" + walinePath}>
            www.neomelt.cloud
          </a>
          。
        </div>
      </>
    ) : (
      <div class="comments-config-tip">
        {commentsFallbacks.noServerPrefix} <code>PUBLIC_WALINE_SERVER_URL</code>
        。
      </div>
    )
  }
</div>

<script>
  const EMOJI_URLS = [
    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/bmoji",
    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/bilibili",
  ];

  function ensureWalineCss(href: string) {
    if (!href || document.querySelector(`link[data-waline-style]`)) return;
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = href;
    link.dataset.walineStyle = "true";
    document.head.appendChild(link);
  }

  function loadWalineUmd(urls: string[]) {
    if (window.__walineLoadClient) return window.__walineLoadClient();

    let promise: Promise<{
      init: (options: Record<string, unknown>) => { destroy?: () => void } | void;
    }> | null = null;

    window.__walineLoadClient = () => {
      if (promise) return promise;
      const win = window as unknown as {
        Waline?: {
          init: (options: Record<string, unknown>) => { destroy?: () => void } | void;
        };
      };
      if (win.Waline) return Promise.resolve(win.Waline);

      promise = new Promise((resolve, reject) => {
        const tryIndex = (idx: number) => {
          if (idx >= urls.length) {
            promise = null;
            reject(new Error("Failed to load Waline client script"));
            return;
          }
          const s = document.createElement("script");
          s.src = urls[idx]!;
          s.async = true;
          s.onload = () => {
            if (win.Waline) resolve(win.Waline);
            else tryIndex(idx + 1);
          };
          s.onerror = () => tryIndex(idx + 1);
          document.head.appendChild(s);
        };
        tryIndex(0);
      });
      return promise;
    };

    return window.__walineLoadClient();
  }

  function setupLazyComments() {
    window.__walineObserver?.disconnect();
    window.__walineInstance?.destroy?.();
    window.__walineInstance = undefined;

    const mount = document.querySelector<HTMLElement>(
      "#waline[data-server-url]",
    );
    const wrapper = mount?.closest<HTMLElement>(".comments-wrapper");
    if (!mount || !wrapper) return;

    const serverURL = mount.dataset.serverUrl || "";
    const walinePath = mount.dataset.walinePath || window.location.pathname;
    const cssHref = wrapper.dataset.walineCss || "";
    let scriptUrls: string[] = [];
    try {
      scriptUrls = JSON.parse(wrapper.dataset.walineScripts || "[]");
    } catch {
      scriptUrls = [];
    }

    let booted = false;
    const boot = () => {
      if (booted) return;
      booted = true;
      window.__walineObserver?.disconnect();
      ensureWalineCss(cssHref);

      loadWalineUmd(scriptUrls)
        .then((waline) => {
          if (!document.contains(mount)) return;
          window.__walineInstance = waline.init({
            el: "#waline",
            serverURL,
            path: walinePath,
            lang:
              localStorage.getItem("site-locale") === "en" ? "en-US" : "zh-CN",
            dark: "html.dark",
            emoji: EMOJI_URLS,
            // WalineCounter handles the lightweight pageview POST on visit, so
            // deferring this 343 KB editor until scroll never drops pageviews.
            pageview: false,
            comment: true,
            meta: ["nick", "mail", "link"],
            requiredMeta: ["nick", "mail"],
          });
        })
        .catch((err) => {
          console.error("[Waline] Failed to initialize comment widget:", err);
          const fallback = document.getElementById("waline-fallback");
          if (fallback) fallback.style.display = "block";
        });
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) boot();
        },
        { rootMargin: "600px 0px" },
      );
      observer.observe(mount);
      window.__walineObserver = observer;
    } else {
      boot();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLazyComments, {
      once: true,
    });
  } else {
    setupLazyComments();
  }
  document.addEventListener("astro:page-load", setupLazyComments);
</script>

<style>
  .comments-wrapper {
    width: 100%;
    max-width: 1000px;
    margin: 4rem auto 0;
    padding: 2rem clamp(0.85rem, 3vw, 2em) 0;
    border-top: 1px solid var(--border);
    box-sizing: border-box;
  }

  .comments-config-tip {
    padding: 0.9rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
    background: var(--bg-code);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .comments-config-tip code {
    color: var(--text);
    font-family: var(--font-mono);
  }

  :global(.wl-editor),
  :global(.wl-panel),
  :global(.wl-card),
  :global(.wl-empty) {
    background: var(--bg-card);
    border-color: var(--border);
  }

  :global(.wl-textarea),
  :global(.wl-input),
  :global(.wl-count) {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .comments-wrapper {
      margin-top: 3rem;
      padding-top: 1.5rem;
    }
  }
</style>

---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { getDefaultUiText } from "../../i18n/ui";
import { estimateReadingTime } from "../../utils/reading-time";
import { getWalinePathForPost } from "../../utils/waline";
import { coverForPost } from "../../utils/cover";
import { withBase } from "../../utils/url";

export interface Props {
  post: CollectionEntry<"blog">;
  /** Resolved publish date - callers already hold the post-dates map. */
  pubDate: Date;
  showReadingTime?: boolean;
  showTags?: boolean;
  maxTags?: number;
}

const {
  post,
  pubDate,
  showReadingTime = false,
  showTags = false,
  maxTags = 4,
} = Astro.props;

const url = withBase(`/posts/${post.id}`);
const walinePath = getWalinePathForPost(post.id);
const readingTime = showReadingTime
  ? estimateReadingTime(post.body || "")
  : null;
const tags = showTags ? (post.data.tags ?? []).slice(0, maxTags) : [];

// Cover art is decorative and deliberately unrelated to the post body.
// Pulling the first body image was wrong: those are screenshots - a Clash
// Verge dialog, a Gazebo viewport - which make poor decorative panels.
//
// Order: the post's own heroImage, then a deterministic pick from the
// configured pool, then a generated gradient. heroImage is ignored when it
// is the shared default, since every post points at the same cover.svg.
const hero =
  typeof post.data.heroImage === "object" && post.data.heroImage
    ? (post.data.heroImage as ImageMetadata)
    : null;

const title = post.data.title;

// No generated stand-in when there is no artwork. A gradient panel in place
// of an image looks like filler, and filler is worse than the honest thing:
// a text listing carried by typography and space.
//
// heroImage is ignored when it is the shared default - every post points at
// the same cover.svg, so honouring it would give identical thumbnails.
const cover: ImageMetadata | null =
  hero && !hero.src.includes("cover.svg") ? hero : await coverForPost(post.id);
---

<a href={url} class="post-card">
  {
    cover && (
      <div class="post-cover" aria-hidden="true">
        <Image src={cover} alt="" widths={[420, 720, 1200]} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="post-card-body">
    <div class="post-card-meta">
      <FormattedDate date={pubDate} />
      {
        post.data.pinned && (
          <span class="badge-pinned" data-i18n="common.pinned">
            {getDefaultUiText("common.pinned")}
          </span>
        )
      }
      {
        readingTime !== null && (
          <span>
            {readingTime}{" "}
            <span data-i18n="common.minutes">
              {getDefaultUiText("common.minutes")}
            </span>
          </span>
        )
      }
    </div>

    <div class="post-card-title">{title}</div>

    {post.data.description && <div class="post-card-desc">{post.data.description}</div>}

    <div class="post-card-stats">
      <span class="waline-pageview-count" data-path={walinePath}>0</span>{" "}
      <span data-i18n="common.views">{getDefaultUiText("common.views")}</span>
      <span class="stats-sep">/</span>
      <span class="waline-comment-count" data-path={walinePath}>0</span>{" "}
      <span data-i18n="common.comments">
        {getDefaultUiText("common.comments")}
      </span>
    </div>

    {
      tags.length > 0 && (
        <div class="post-card-tags">
          {tags.map((tag: string) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )
    }
  </div>

</a>

<style>
  /* Both the frame and the thumbnail column come from the skin: minimal is a
     divided list with a small square thumb, anime is a detached card with a
     larger one. Setting --card-cover-size to 0 drops the column without any
     markup change. */
  .post-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    padding: var(--list-item-padding);
    padding-inline-end: calc(
      var(--card-body-pad-end) + var(--list-item-padding-end, 0px)
    );
    margin-bottom: var(--list-item-gap);
    border: var(--list-item-border-width) solid var(--border);
    border-bottom-width: var(--list-item-divider-width);
    border-radius: var(--list-item-radius);
    background-color: var(--list-item-surface);
    background-image: var(--surface-sheen);
    box-shadow: var(--list-item-shadow);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  /* Inside @supports: without backdrop-filter a translucent card would leave
     text sitting straight on the artwork. */
  @supports (backdrop-filter: blur(1px)) {
    .post-card {
      -webkit-backdrop-filter: blur(var(--list-item-blur));
      backdrop-filter: blur(var(--list-item-blur));
    }

    /* Blur is per-frame GPU work on every card. On a phone, where the
       backdrop is already faded, it costs scrolling smoothness for an effect
       nobody can see. */
    @media (max-width: 768px) {
      .post-card {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }
  }

  .post-card:hover {
    transform: translateX(var(--card-hover-lift));
    background-color: rgba(var(--accent-rgb), var(--card-hover-tint));
  }

  /* In a divided list the trailing hairline is redundant; in a card layout
     the bottom edge is part of the frame. */
  .post-card:last-child {
    border-bottom-width: var(--list-item-border-width);
    margin-bottom: 0;
  }

  /* Sits behind the text at partial opacity and masked away on its left
     edge, so the copy never lands on busy artwork. Only rendered when there
     is a real image - see the comment on `cover`. */
  .post-cover {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--card-cover-width);
    z-index: -1;
    opacity: var(--card-cover-opacity);
    transition: opacity var(--transition);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black var(--card-cover-fade)
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black var(--card-cover-fade)
    );
  }

  .post-card:hover .post-cover {
    opacity: calc(var(--card-cover-opacity) * 1.45);
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    /* Tabular figures so dates line up down the column. */
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: 0.55rem;
  }

  .post-card-title {
    font-size: 1.28rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.008em;
    color: var(--text);
    margin-bottom: 0.4rem;
    transition: color var(--transition);
  }

  .post-card:hover .post-card-title {
    color: var(--accent);
  }

  .post-card-desc {
    font-size: 0.94rem;
    color: var(--text-muted);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Italics on a stats line reads as a template default; the references
     keep this the same weight as the rest of the metadata. */
  .post-card-stats {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .stats-sep {
    margin: 0 0.35rem;
    color: var(--text-muted);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  /* On narrow screens the copy needs the full width, so the cover spans the
     card and fades from the bottom instead of the side. */
  @media (max-width: 560px) {
    .post-cover {
      width: 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 70%);
      mask-image: linear-gradient(to bottom, transparent 0%, black 70%);
    }
  }

  /* ---- list: an inset thumbnail beside the text ---- */
  :global([data-layout="list"]) .post-card {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 1rem;
  }

  :global([data-layout="list"]) .post-cover {
    position: static;
    flex: none;
    width: var(--thumb-width);
    height: var(--thumb-height);
    z-index: 0;
    opacity: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    -webkit-mask-image: none;
    mask-image: none;
  }

  :global([data-layout="list"]) .post-card-body {
    min-width: 0;
    flex: 1;
  }

  /* ---- grid / magazine: cover on top, in flow ---- */
  :global([data-layout="grid"]) .post-card,
  :global([data-layout="magazine"]) .post-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin-bottom: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--bg-card);
  }

  :global([data-layout="grid"]) .post-cover,
  :global([data-layout="magazine"]) .post-cover {
    position: static;
    width: 100%;
    aspect-ratio: 16 / 9;
    z-index: 0;
    opacity: 1;
    -webkit-mask-image: none;
    mask-image: none;
  }

  :global([data-layout="grid"]) .post-card-body,
  :global([data-layout="magazine"]) .post-card-body {
    padding: 1rem 1.1rem 1.2rem;
  }

  :global([data-layout="grid"]) .post-card:hover,
  :global([data-layout="magazine"]) .post-card:hover {
    transform: none;
    border-color: rgba(var(--accent-rgb), 0.45);
  }

  /* The hero card in magazine layout gets a taller cover and bigger title. */
  :global([data-layout="magazine"]) .post-list > :first-child .post-cover {
    aspect-ratio: 21 / 9;
  }

  :global([data-layout="magazine"]) .post-list > :first-child .post-card-title {
    font-size: 1.6rem;
  }

  /* ---- timeline: a dot on the rail, no frame ---- */
  :global([data-layout="timeline"]) .post-card {
    position: relative;
    padding: 0.9rem 0;
    margin-bottom: 0;
    border: none;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  :global([data-layout="timeline"]) .post-card::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(-1.6rem - 5px);
    top: 1.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg);
  }

  :global([data-layout="timeline"]) .post-cover {
    display: none;
  }

  :global([data-layout="timeline"]) .post-card-desc {
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>

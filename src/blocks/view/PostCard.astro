---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { getDefaultUiText } from "../../i18n/ui";
import { estimateReadingTime } from "../../utils/reading-time";
import { getWalinePathForPost } from "../../utils/waline";
import { postTitleTransition } from "../../utils/transition";
import { withBase } from "../../utils/url";

// Keep arrangement stylesheets in this chunk for the layout contract.
import.meta.glob("/src/arrangements/*.css", { eager: true });

export interface Props {
  post: CollectionEntry<"blog">;
  /** Resolved publish date - callers already hold the post-dates map. */
  pubDate: Date;
  /** Four-digit year string (used when filtering re-groups visible rows). */
  year?: string;
  /** Non-empty on the first post of a year group to render hanging year mark. */
  yearMark?: string;
  showReadingTime?: boolean;
  showTags?: boolean;
  maxTags?: number;
}

const {
  post,
  pubDate,
  year = String(pubDate.getFullYear()),
  yearMark = "",
  showReadingTime = false,
  showTags = false,
  maxTags = 4,
} = Astro.props;

const url = withBase(`/posts/${post.id}`);
const walinePath = getWalinePathForPost(post.id);
const readingTime = showReadingTime
  ? estimateReadingTime(post.body || "")
  : null;
const tags = showTags ? (post.data.tags ?? []).slice(0, maxTags) : [];
const postType = post.data.type ?? "tech";
const typeLabelKey = postType === "story" ? "common.essay" : "common.tech";
const category = (post.data.category ?? "").trim();
const title = post.data.title;
---

<a
  href={url}
  class="post-card"
  data-post-type={postType}
  data-post-category={category}
  data-post-year={year}
>
  <div class="post-card-margin" aria-hidden="true">
    <span class="post-year-mark" data-year-mark>{yearMark}</span>
  </div>

  <div class="post-card-body">
    <div class="post-card-headline">
      {
        post.data.pinned && (
          <span class="badge-pinned" data-i18n="common.pinned">
            {getDefaultUiText("common.pinned")}
          </span>
        )
      }
      <div class="post-card-title" style={postTitleTransition(post.id)}>
        {title}
      </div>
      <span class="post-card-leader" aria-hidden="true"></span>
      <span class="post-card-date">
        <FormattedDate date={pubDate} />
      </span>
    </div>

    {
      post.data.description && (
        <div class="post-card-desc">{post.data.description}</div>
      )
    }

    <div class="post-card-meta">
      <span class="post-card-date-mobile">
        <FormattedDate date={pubDate} />
      </span>
      <span class="post-card-kind">
        <i class:list={["kind-dot", `is-${postType}`]} aria-hidden="true"></i>
        <span data-i18n={typeLabelKey}>{getDefaultUiText(typeLabelKey)}</span>
        {
          category && (
            <>
              <span class="kind-sep">·</span>
              <span>{category}</span>
            </>
          )
        }
      </span>
      {
        readingTime !== null && (
          <>
            <span class="meta-slash">/</span>
            <span>
              {readingTime}{" "}
              <span data-i18n="common.minutes">
                {getDefaultUiText("common.minutes")}
              </span>
            </span>
          </>
        )
      }
      <span class="meta-slash">/</span>
      <span class="post-card-stats">
        <span class="waline-pageview-count" data-path={walinePath}>0</span>{" "}
        <span data-i18n="common.views">{getDefaultUiText("common.views")}</span>
        <span class="stats-sep">·</span>
        <span class="waline-comment-count" data-path={walinePath}>0</span>{" "}
        <span data-i18n="common.comments">
          {getDefaultUiText("common.comments")}
        </span>
      </span>

      {
        tags.length > 0 && (
          <>
            <span class="meta-slash">/</span>
            <span class="post-card-tags">
              {tags.map((tag: string) => (
                <span class="post-card-tag">#{tag}</span>
              ))}
            </span>
          </>
        )
      }
    </div>
  </div>
</a>

<style>
  .post-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    padding: var(--list-item-padding);
    padding-inline-end: calc(
      var(--card-body-pad-end) + var(--list-item-padding-end, 0px)
    );
    margin-bottom: var(--list-item-gap);
    border: var(--list-item-border-width) solid var(--border);
    border-bottom-width: var(--list-item-divider-width);
    border-radius: var(--list-item-radius);
    background-color: var(--list-item-surface);
    background-image: var(--surface-sheen);
    box-shadow: var(--list-item-shadow);
    text-decoration: none;
    color: inherit;
    transition:
      opacity 220ms ease,
      transform var(--transition),
      background-color var(--transition),
      border-color var(--transition);
  }

  @supports (backdrop-filter: blur(1px)) {
    .post-card {
      -webkit-backdrop-filter: blur(var(--list-item-blur));
      backdrop-filter: blur(var(--list-item-blur));
    }

    @media (max-width: 768px) {
      .post-card {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }
  }

  .post-card:hover {
    transform: translateX(var(--card-hover-lift));
    background-color: rgba(var(--accent-rgb), var(--card-hover-tint));
  }

  .post-card:last-child {
    border-bottom-width: var(--list-item-border-width);
    margin-bottom: 0;
  }

  .post-card-margin {
    padding-top: 0.12rem;
  }

  .post-year-mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .post-year-mark:empty {
    display: none;
  }

  .post-card-headline {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.42rem;
    min-width: 0;
  }

  .post-card-title {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.38;
    letter-spacing: -0.008em;
    color: var(--text);
    transition: color var(--transition);
    min-width: 0;
  }

  .post-card:hover .post-card-title {
    color: var(--accent);
  }

  /* Dotted book leader connecting title and date */
  .post-card-leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--border);
    position: relative;
    top: -4px;
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .post-card-date-mobile {
    display: none;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .post-card-desc {
    font-size: 0.94rem;
    color: var(--text-muted);
    line-height: 1.72;
    margin-bottom: 0.58rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.77rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .meta-slash {
    opacity: 0.4;
  }

  .post-card-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .kind-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .kind-dot.is-tech {
    background: var(--accent);
  }

  .kind-dot.is-story {
    background: var(--badge-text);
  }

  .kind-sep {
    opacity: 0.5;
  }

  .post-card-stats {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .stats-sep {
    margin: 0 0.25rem;
    opacity: 0.55;
  }

  .post-card-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }

  .post-card-tag {
    color: var(--text-muted);
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .post-card-leader,
    .post-card-date {
      display: none;
    }

    .post-card-date-mobile {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>

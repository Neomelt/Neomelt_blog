<script>
  const OPEN_CLASS = "lightbox-open";
  let activeCleanup = null;

  function getMaxScale(img, rect) {
    const fitW = (window.innerWidth * 0.92) / rect.width;
    const fitH = (window.innerHeight * 0.92) / rect.height;
    let scale = Math.min(fitW, fitH);

    // 位图放大不超过原始分辨率（再放就糊了）；SVG 矢量图不设上限。
    // src 可能是 Astro 的 /_image?href=...%2Fxxx.svg&f=svg 形式，需解码后再判断
    const src = img.currentSrc || img.src || "";
    let decoded = src;
    try {
      decoded = decodeURIComponent(src);
    } catch {
      /* 保底用原始 src */
    }
    const isVector = /\.svg\b/i.test(decoded);
    if (!isVector && img.naturalWidth > 0) {
      scale = Math.min(scale, img.naturalWidth / rect.width);
    }
    return Math.max(scale, 1);
  }

  function openLightbox(img) {
    if (activeCleanup) return;

    const rect = img.getBoundingClientRect();
    const scale = getMaxScale(img, rect);
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const backdrop = document.createElement("div");
    backdrop.className = "lightbox-backdrop";
    backdrop.setAttribute("role", "dialog");
    backdrop.setAttribute("aria-modal", "true");
    if (img.alt) backdrop.setAttribute("aria-label", img.alt);

    const clone = document.createElement("img");
    clone.className = "lightbox-image";
    clone.src = img.currentSrc || img.src;
    clone.alt = img.alt || "";
    clone.style.top = `${rect.top}px`;
    clone.style.left = `${rect.left}px`;
    clone.style.width = `${rect.width}px`;
    clone.style.height = `${rect.height}px`;

    // 目标位移：图片中心 → 视口中心
    const dx = window.innerWidth / 2 - (rect.left + rect.width / 2);
    const dy = window.innerHeight / 2 - (rect.top + rect.height / 2);

    document.body.appendChild(backdrop);
    document.body.appendChild(clone);
    if (img.alt) {
      const caption = document.createElement("figcaption");
      caption.className = "lightbox-caption";
      caption.textContent = img.alt;
      backdrop.appendChild(caption);
    }

    document.body.classList.add(OPEN_CLASS);
    img.style.visibility = "hidden";
    if (reduceMotion) {
      clone.style.transition = "none";
      backdrop.style.transition = "none";
    }

    // 强制 reflow，让初始位置生效后再过渡
    void clone.getBoundingClientRect();
    backdrop.classList.add("is-visible");
    clone.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;

    const close = () => {
      document.removeEventListener("keydown", onKeydown);
      backdrop.classList.remove("is-visible");
      clone.style.transform = "";

      const finish = () => {
        backdrop.remove();
        clone.remove();
        img.style.visibility = "";
        document.body.classList.remove(OPEN_CLASS);
        activeCleanup = null;
      };
      if (reduceMotion) {
        finish();
      } else {
        clone.addEventListener("transitionend", finish, { once: true });
        // transitionend 偶尔不触发（元素被移出视口等），兜底
        setTimeout(finish, 400);
      }
    };

    const onKeydown = (event) => {
      if (event.key === "Escape") close();
    };

    backdrop.addEventListener("click", close);
    clone.addEventListener("click", close);
    document.addEventListener("keydown", onKeydown);
    activeCleanup = close;
  }

  document.addEventListener("click", (event) => {
    const img = event.target;
    if (!(img instanceof HTMLImageElement)) return;
    if (!img.closest(".prose")) return;
    if (img.closest("a")) return; // 链接里的图片保持跳转行为
    openLightbox(img);
  });
</script>

<style is:global>
  .prose img {
    cursor: zoom-in;
  }

  .prose a img {
    cursor: pointer;
  }

  body.lightbox-open {
    overflow: hidden;
  }

  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(8, 10, 14, 0.82);
    opacity: 0;
    transition: opacity 0.28s ease;
    cursor: zoom-out;
  }

  .lightbox-backdrop.is-visible {
    opacity: 1;
  }

  .lightbox-image {
    position: fixed;
    z-index: 201;
    margin: 0;
    border-radius: var(--radius-sm);
    transition: transform 0.28s cubic-bezier(0.2, 0, 0.2, 1);
    transform-origin: center center;
    cursor: zoom-out;
    will-change: transform;
  }

  .lightbox-caption {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    max-width: 86vw;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.45);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

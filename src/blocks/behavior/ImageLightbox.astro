<script>
  type GalleryItem = { src: string; width: number; height: number };
  const OPEN_CLASS = "lightbox-open";
  /** Set while a lightbox is open; calling it tears that one down. */
  let activeCleanup: (() => void) | null = null;

  function galleryFor(img: HTMLImageElement) {
    const container = img.closest<HTMLElement>("[data-lightbox-gallery]");
    const sources = container
      ? Array.from(
          container.querySelectorAll<HTMLImageElement>(
            "img[data-lightbox-src]",
          ),
        )
      : [img];
    const items: GalleryItem[] = sources.map((source) => ({
      src: source.dataset.lightboxSrc || source.currentSrc || source.src,
      width:
        Number(source.dataset.lightboxWidth) ||
        source.naturalWidth ||
        source.width,
      height:
        Number(source.dataset.lightboxHeight) ||
        source.naturalHeight ||
        source.height,
    }));
    const start = Math.max(0, sources.indexOf(img));
    return { items, start };
  }

  function openLightbox(img: HTMLImageElement) {
    if (activeCleanup) return;

    const gallery = galleryFor(img);
    let current = gallery.start;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const backdrop = document.createElement("div");
    backdrop.className = "lightbox-backdrop";
    backdrop.setAttribute("role", "dialog");
    backdrop.setAttribute("aria-modal", "true");
    if (img.alt) backdrop.setAttribute("aria-label", img.alt);

    const clone = document.createElement("img");
    clone.className = "lightbox-image";
    clone.src = gallery.items[current]!.src;
    clone.alt = img.alt || "";
    clone.style.opacity = "1";
    clone.style.transform = "translate(-50%, -50%)";

    const previous = document.createElement("button");
    previous.type = "button";
    previous.className = "lightbox-control lightbox-prev";
    previous.setAttribute("aria-label", "上一张");
    previous.textContent = "‹";
    const next = document.createElement("button");
    next.type = "button";
    next.className = "lightbox-control lightbox-next";
    next.setAttribute("aria-label", "下一张");
    next.textContent = "›";
    const counter = document.createElement("span");
    counter.className = "lightbox-counter";

    const updateCounter = () => {
      const hasGallery = gallery.items.length > 1;
      previous.hidden = !hasGallery;
      next.hidden = !hasGallery;
      counter.hidden = !hasGallery;
      counter.textContent = `${current + 1} / ${gallery.items.length}`;
    };

    const showItem = (index: number) => {
      current = (index + gallery.items.length) % gallery.items.length;
      const item = gallery.items[current]!;
      clone.alt = img.alt || "";
      clone.width = item.width;
      clone.height = item.height;
      clone.src = item.src;
      updateCounter();
    };

    const goTo = (index: number) => {
      showItem(index);
      clone.style.opacity = "0.3";
      requestAnimationFrame(() => {
        clone.style.opacity = "1";
      });
    };

    document.body.appendChild(backdrop);
    backdrop.append(clone, previous, next, counter);
    if (img.alt) {
      const caption = document.createElement("figcaption");
      caption.className = "lightbox-caption";
      caption.textContent = img.alt;
      backdrop.appendChild(caption);
    }

    document.body.classList.add(OPEN_CLASS);
    img.style.visibility = "hidden";
    if (reduceMotion) {
      clone.style.transition = "none";
      backdrop.style.transition = "none";
    }

    // 让初始图片直接落在居中的观看区域，避免不同长宽比之间发生挤压动画。
    showItem(current);
    backdrop.classList.add("is-visible");

    const close = () => {
      document.removeEventListener("keydown", onKeydown);
      backdrop.classList.remove("is-visible");
      clone.style.opacity = "0";

      const finish = () => {
        backdrop.remove();
        clone.remove();
        img.style.visibility = "";
        document.body.classList.remove(OPEN_CLASS);
        activeCleanup = null;
      };
      if (reduceMotion) {
        finish();
      } else {
        clone.addEventListener("transitionend", finish, { once: true });
        // transitionend 偶尔不触发（元素被移出视口等），兜底
        setTimeout(finish, 400);
      }
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") close();
      if (event.key === "ArrowLeft") goTo(current - 1);
      if (event.key === "ArrowRight") goTo(current + 1);
    };

    backdrop.addEventListener("click", close);
    clone.addEventListener("click", close);
    previous.addEventListener("click", (event) => {
      event.stopPropagation();
      goTo(current - 1);
    });
    next.addEventListener("click", (event) => {
      event.stopPropagation();
      goTo(current + 1);
    });
    document.addEventListener("keydown", onKeydown);
    activeCleanup = close;
  }

  document.addEventListener("click", (event) => {
    const img = event.target;
    if (!(img instanceof HTMLImageElement)) return;
    if (!img.closest(".prose")) return;
    if (img.closest("a")) return; // 链接里的图片保持跳转行为
    openLightbox(img);
  });
</script>

<style is:global>
  .prose img {
    cursor: zoom-in;
  }

  .prose a img {
    cursor: pointer;
  }

  body.lightbox-open {
    overflow: hidden;
  }

  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: rgba(2, 4, 8, 0.94);
    opacity: 0;
    transition: opacity 0.28s ease;
    cursor: zoom-out;
  }

  .lightbox-backdrop.is-visible {
    opacity: 1;
  }

  .lightbox-image {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: var(--z-overlay-control);
    margin: 0;
    border-radius: var(--radius-sm);
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 84vh;
    object-fit: contain;
    object-position: center;
    transition:
      transform 0.28s cubic-bezier(0.2, 0, 0.2, 1),
      opacity 0.16s ease;
    transform-origin: center center;
    cursor: zoom-out;
    will-change: transform;
  }

  .lightbox-control {
    position: fixed;
    top: 50%;
    z-index: calc(var(--z-overlay-control) + 1);
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(8, 10, 14, 0.58);
    color: #fff;
    font: 2rem/1 sans-serif;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .lightbox-control:hover {
    background: rgba(8, 10, 14, 0.82);
  }

  .lightbox-control:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .lightbox-prev {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  .lightbox-counter {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: calc(var(--z-overlay-control) + 1);
    transform: translateX(-50%);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(8, 10, 14, 0.58);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-control[hidden],
  .lightbox-counter[hidden] {
    display: none;
  }

  .lightbox-caption {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    max-width: 86vw;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.45);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

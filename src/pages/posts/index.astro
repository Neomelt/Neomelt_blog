---
import { getCollection } from "astro:content";
import Pagination from "../../blocks/widget/Pagination.astro";
import PostCard from "../../blocks/widget/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paginate } from "../../utils/pagination.ts";
import { SITE_TITLE } from "../../consts";
import { getDefaultUiText } from "../../i18n/ui";
import { getPostDateKey, resolvePostDatesMap } from "../../utils/post-dates";
import { withBase } from "../../utils/url";

const posts = await getCollection("blog", ({ data }) => !data.hidden);
const postDatesMap = await resolvePostDatesMap(posts);

posts.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  const aDate = postDatesMap.get(getPostDateKey(a))?.pubDate ?? a.data.pubDate;
  const bDate = postDatesMap.get(getPostDateKey(b))?.pubDate ?? b.data.pubDate;
  return bDate.valueOf() - aDate.valueOf();
});

const { items: paginatedPosts, pagination } = paginate(posts, 1, 10);
---

<BaseLayout title={`${getDefaultUiText("posts.metaTitle")} | ${SITE_TITLE}`}>
  <main>
    <div class="container">
      <nav
        class="breadcrumb"
        data-i18n-aria-label="post.breadcrumbAria"
        aria-label={getDefaultUiText("post.breadcrumbAria")}
      >
        <a href={withBase("/")} data-i18n="common.home"
          >{getDefaultUiText("common.home")}</a
        >
        <span class="breadcrumb-sep">/</span>
        <span data-i18n="common.posts">{getDefaultUiText("common.posts")}</span>
      </nav>

      <h1 class="section-heading" data-i18n="posts.title">
        {getDefaultUiText("posts.title")}
      </h1>

      <div class="post-list">
        {
          paginatedPosts.map((post) => (
            <PostCard
              post={post}
              pubDate={
                postDatesMap.get(getPostDateKey(post))?.pubDate ?? post.data.pubDate
              } showReadingTime showTags
            />
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <p
            class="text-muted"
            style="text-align:center;padding:3rem 0"
            data-i18n="posts.empty"
          >
            {getDefaultUiText("posts.empty")}
          </p>
        )
      }

      {
        pagination.totalPages > 1 && (
          <Pagination pagination={pagination} basePath="/posts" />
        )
      }
    </div>
  </main>
</BaseLayout>

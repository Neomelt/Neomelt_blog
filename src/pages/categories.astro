---
import { getCollection } from "astro:content";
import TermIndex from "../blocks/view/TermIndex.astro";
import { SITE_TITLE } from "../consts";
import { getDefaultUiText } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateTime } from "../utils/format-date";
import { getPostDateKey, resolvePostDatesMap } from "../utils/post-dates";
import { withBase } from "../utils/url";

const posts = await getCollection("blog", ({ data }) => !data.hidden);
const postDatesMap = await resolvePostDatesMap(posts);
const pubDate = (post: (typeof posts)[number]): Date =>
  postDatesMap.get(getPostDateKey(post))?.pubDate ?? post.data.pubDate;

// A post has exactly one category, and an absent one falls back to a label
// so sidebar links still resolve. That fallback is why this cannot share
// the tag page's grouping code.
const uncategorizedLabel = getDefaultUiText("legacy.uncategorized");
const categoryOf = (post: (typeof posts)[number]): string =>
  post.data.category || uncategorizedLabel;

const categoryCounts: Record<string, number> = {};
for (const post of posts) {
  const category = categoryOf(post);
  categoryCounts[category] = (categoryCounts[category] || 0) + 1;
}
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);

const terms = categories.map(([name, count]) => ({ name, count }));
const groups = categories.map(([category]) => ({
  name: category,
  posts: posts
    .filter((p) => categoryOf(p) === category)
    .sort((a, b) => pubDate(b).valueOf() - pubDate(a).valueOf())
    .map((post) => ({
      title: post.data.title,
      url: withBase(`/posts/${post.id}`),
      date: formatDateTime(pubDate(post)),
    })),
}));
---

<BaseLayout
  title={`${getDefaultUiText("sidebar.categories")} | ${SITE_TITLE}`}
>
  <main>
    <div class="container">
      <TermIndex
        titleKey="sidebar.categories"
        terms={terms}
        groups={groups}
      />
    </div>
  </main>
</BaseLayout>

---
import { getCollection } from "astro:content";
import TermIndex from "../blocks/view/TermIndex.astro";
import { SITE_TITLE } from "../consts";
import { getDefaultUiText } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateTime } from "../utils/format-date";
import { getPostDateKey, resolvePostDatesMap } from "../utils/post-dates";
import { withBase } from "../utils/url";

const posts = await getCollection("blog", ({ data }) => !data.hidden);
const postDatesMap = await resolvePostDatesMap(posts);
const pubDate = (post: (typeof posts)[number]): Date =>
  postDatesMap.get(getPostDateKey(post))?.pubDate ?? post.data.pubDate;

// A post carries several tags, so it appears under each of them. This is the
// half that differs from the category page; the rendering is shared.
const tagCounts: Record<string, number> = {};
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const terms = tags.map(([name, count]) => ({ name, count }));
const groups = tags.map(([tag]) => ({
  name: tag,
  posts: posts
    .filter((p) => p.data.tags?.includes(tag))
    .sort((a, b) => pubDate(b).valueOf() - pubDate(a).valueOf())
    .map((post) => ({
      title: post.data.title,
      url: withBase(`/posts/${post.id}`),
      date: formatDateTime(pubDate(post)),
    })),
}));
---

<BaseLayout title={`${getDefaultUiText("tags.metaTitle")} | ${SITE_TITLE}`}>
  <main>
    <div class="container">
      <TermIndex
        titleKey="tags.title"
        terms={terms}
        groups={groups}
        prefix="#"
      />
    </div>
  </main>
</BaseLayout>
